{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "admin/package.json", "use": "@vercel/static-build", "config": { "distDir": "admin-build" } },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/.*", "dest": "/api/index.js" },
    { "src": "^/admin/(.*)", "dest": "/admin-build/$1" },
    { "src": "^/admin$", "dest": "/admin-build/index.html" },
    { "src": "^/static/(.*)", "dest": "/build/static/$1" },
    { "src": "^/favicon.ico$", "dest": "/build/favicon.ico" },
    { "src": "^/manifest.json$", "dest": "/build/manifest.json" },
    { "src": "^/asset-manifest.json$", "dest": "/build/asset-manifest.json" },
    { "src": "^(?!/api|/admin).*$", "dest": "/build/index.html" }
  ]
}
